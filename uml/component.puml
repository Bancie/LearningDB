@startuml PersonalDatabaseComponents
title LearningDB Component Diagram


component "LearningDB Web App" {
    portin "port dashboard" as p1
    portin "port import" as p2
    portin "port list" as p3
    component "Database" as DA
    component "Query Builder" as QB
    component "Analytics Dashboard" as AD
    AD - p1
    interface query
    query - QB
    p2 -> query
    QB --> DA
    AD --> DA
    interface list
    list <- p3
    list -- QB
}
interface "Dashboard (Read-only)" as dbp
dbp -- p1
interface "Data Import" as dti
dti -- p2
interface "My Activity List" as mal
mal -- p3
@enduml