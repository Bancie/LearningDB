Table "ACTIVITY" {
  "ACTIVITY_ID" int [pk, not null, increment]
  "USER_ID" int [not null]
  "ACT_NAME" varchar(500)
  "ACTIVITY_TAGS" ACTIVITY_ACTIVITY_TAGS_enum
  "ACTIVITY_CATEGORY" ACTIVITY_ACTIVITY_CATEGORY_enum
  "IS_RESEARCH" tinyint(1)
  "ACT_STATUS" ACTIVITY_ACT_STATUS_enum
  "PRIOR_PROB" decimal(5,4)
  "POSTERIOR_PROB_LEARNING" decimal(5,4)
  "POSTERIOR_PROB_OVERVIEW" decimal(5,4)
  "POSTERIOR_PROB_PRACTICE" decimal(5,4)
  "CREATED_AT" timestamp [default: `CURRENT_TIMESTAMP`]
  "UPDATED_AT" "timestamp on update CURRENT_TIMESTAMP" [default: `CURRENT_TIMESTAMP`]
}

Table "ACTIVITY_LOG" {
  "ACTI_LOG_ID" int [pk, not null, increment]
  "USER_ID" int [not null]
  "ACTIVITY_ID" int [not null]
  "DAY_ID" int [not null]
  "SOUND_BACKGROUND" set('category_music','category_white_noise','category_ambient_noise','category_silence','category_podcast','category_construction','category_nature','source_headphones','source_earbuds','source_speakers','source_public','source_private_room')
  "SOUND_INTENSITY" ACTIVITY_LOG_SOUND_INTENSITY_enum
  "DEVICE" ACTIVITY_LOG_DEVICE_enum
  "ACTLOG_LOCATION" ACTIVITY_LOG_ACTLOG_LOCATION_enum
  "WEATHER" ACTIVITY_LOG_WEATHER_enum
  "TEMPERATURE" ACTIVITY_LOG_TEMPERATURE_enum
  "MOOD" ACTIVITY_LOG_MOOD_enum
  "HEALTH" ACTIVITY_LOG_HEALTH_enum
  "ENERGY" ACTIVITY_LOG_ENERGY_enum
  "HUNGER" ACTIVITY_LOG_HUNGER_enum
  "AROUSAL" ACTIVITY_LOG_AROUSAL_enum
  "AC_ON" tinyint(1)
  "ACTLOG_START" time

  Indexes {
    ACTIVITY_ID [type: btree, name: "ACTIVITY_ID"]
    DAY_ID [type: btree, name: "DAY_ID"]
    USER_ID [type: btree, name: "USER_ID"]
  }
}

Table "ACTIVITY_OUTPUT" {
  "AO_ID" int [pk, not null, increment]
  "ACTI_LOG_ID" int [not null]
  "AO_FINISH" time
  "BREAK_TIME" int
  "AO_SATISFACTION" ACTIVITY_OUTPUT_AO_SATISFACTION_enum
  "FOCUS_LEVEL" ACTIVITY_OUTPUT_FOCUS_LEVEL_enum
  "TARGET_MET" tinyint(1)
}

Table "DAY" {
  "DAY_ID" int [pk, not null, increment]
  "USER_ID" int [not null]
  "DAY" date
  "IS_EVENT" tinyint(1)
  "IS_FREE" tinyint(1)

  Indexes {
    USER_ID [type: btree, name: "USER_ID"]
  }
}

Table "EATING_LOG" {
  "USER_ID" int [not null]
  "DAY_ID" int [not null]
  "EAT_TIME" time [not null]
  "EAT_TYPE" EATING_LOG_EAT_TYPE_enum
  "FOOD" EATING_LOG_FOOD_enum
  "EAT_AMOUNT" EATING_LOG_EAT_AMOUNT_enum
  "FOOD_SOURCE" EATING_LOG_FOOD_SOURCE_enum
  "HEALTHINESS" EATING_LOG_HEALTHINESS_enum
  "FLAVOUR" EATING_LOG_FLAVOUR_enum
  "EAT_FILL" EATING_LOG_EAT_FILL_enum

  Indexes {
    DAY_ID [type: btree, name: "DAY_ID"]
    (USER_ID, DAY_ID, EAT_TIME) [pk, name: "PRIMARY"]
  }
}

Table "FITNESS_LOG" {
  "USER_ID" int [not null]
  "DAY_ID" int [not null]
  "FITNESS_START" time [not null]
  "FITNESS_TYPE" FITNESS_LOG_FITNESS_TYPE_enum
  "FITNESS_DURATION_MINUTES" int
  "FITNESS_INTENSITY" FITNESS_LOG_FITNESS_INTENSITY_enum

  Indexes {
    DAY_ID [type: btree, name: "DAY_ID"]
    (USER_ID, DAY_ID, FITNESS_START) [pk, name: "PRIMARY"]
  }
}

Table "KIT_ACADEMIC_READING" {
  "KIT_ACADEMIC_READING_ID" int [pk, not null, increment]
  "AO_ID" int [not null]
  "COMPREHENSION_DEPTH" KIT_ACADEMIC_READING_COMPREHENSION_DEPTH_enum
  "PROOF_TRACE_ABILITY" KIT_ACADEMIC_READING_PROOF_TRACE_ABILITY_enum
  "LINKING_TO_PREVIOUS_KNOWLEDGE" KIT_ACADEMIC_READING_LINKING_TO_PREVIOUS_KNOWLEDGE_enum
  "MENTAL_FATIGUE" KIT_ACADEMIC_READING_MENTAL_FATIGUE_enum
  "READING_SPEED_FOR_PROOF" KIT_ACADEMIC_READING_READING_SPEED_FOR_PROOF_enum
  "READING_AMOUNT" KIT_ACADEMIC_READING_READING_AMOUNT_enum
  "CONTENT_LEVEL" KIT_ACADEMIC_READING_CONTENT_LEVEL_enum
  "SPEED_READ" KIT_ACADEMIC_READING_SPEED_READ_enum
}

Table "KIT_COUNT" {
  "KIT_COUNT_ID" int [pk, not null, increment]
  "AO_ID" int [not null]
  "TOTAL_COUNT" float
  "UNIT_COUNT" KIT_COUNT_UNIT_COUNT_enum
}

Table "KIT_EXERCISES" {
  "KIT_EXERCISES_ID" int [pk, not null, increment]
  "AO_ID" int [not null]
  "TOTAL_QUESTION" int
  "TRUE_TOTAL" int
  "TIME_FINISH" KIT_EXERCISES_TIME_FINISH_enum
}

Table "KIT_IELTS_LISTENING" {
  "KIT_IELTS_LISTENING_ID" int [pk, not null, increment]
  "AO_ID" int [not null]
  "SCORE_BAND" float
  "COMPREHENSION_TYPE" KIT_IELTS_LISTENING_COMPREHENSION_TYPE_enum
  "TOPIC_FAMILIARITY" KIT_IELTS_LISTENING_TOPIC_FAMILIARITY_enum
  "SPEED_HANDLING" KIT_IELTS_LISTENING_SPEED_HANDLING_enum
  "SPELLING_ACCURACY" KIT_IELTS_LISTENING_SPELLING_ACCURACY_enum
  "ANSWER_COMPLETION" KIT_IELTS_LISTENING_ANSWER_COMPLETION_enum
  "AUDIO_RECOGNITION" KIT_IELTS_LISTENING_AUDIO_RECOGNITION_enum
}

Table "KIT_IELTS_READING" {
  "KIT_IELTS_READING_ID" int [pk, not null, increment]
  "AO_ID" int [not null]
