{
    "mcpServers": {
      "pandas-mcp": {
        "command": "uv",
        "args": [
          "run",
          "--directory",
          "${workspaceFolder}/tools/mcp/pandas-mcp-server",
          "pandas-mcp-server"
        ]
      },
      "mcp-server-ds": {
        "command": "uv",
        "args": [
          "run",
          "--directory",
          "${workspaceFolder}/tools/mcp/mcp-server-data-exploration",
          "mcp-server-ds"
        ]
      },
      "excalidraw": {
        "url": "https://api.excalidraw.com/api/v1/mcp",
        "headers": {
          "Authorization": "Bearer ${env:EXCALIDRAW_API_KEY}"
        }
      }
    }
  }
  